{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main launcher window",
  "windows": ["launcher", "manager", "clipboard-launcher", "screenshot-overlay"],
  "permissions": [
    "core:default",
    "clipboard-manager:default",
    "global-shortcut:default",
    "notification:default",
    "sql:default",
    "dialog:default",
    "autostart:default",
    "updater:default"
  ]
}
