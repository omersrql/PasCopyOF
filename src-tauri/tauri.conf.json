{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PasCopyOf",
  "version": "0.2.1",
  "identifier": "com.pascopyof.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "PasCopyOf",
        "url": "/",
        "width": 640,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "focus": true
      },
      {
        "label": "clipboard-launcher",
        "title": "PasCopyOf Clipboard",
        "url": "/#/clipboard",
        "width": 900,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "focus": true
      },
      {
        "label": "screenshot-overlay",
        "title": "PasCopyOf Screenshot",
        "url": "/#/screenshot",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "global-shortcut": null,
    "clipboard-manager": null,
    "notification": null,
    "sql": null,
    "dialog": null,
    "autostart": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFQTg1MDNGMkNFODQzNjYKUldSbVErZ3NQMUNvSHJtNUJJcklQMHdDcDdtRWdMMlNaNjVWbEx2dmw2UjhQL0k4bFU2TS9yVzQK",
      "endpoints": [
        "https://github.com/omersrql/PasCopyOF/releases/latest/download/latest.json"
      ]
    }
  }
}
